{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "shared/*": ["shared/*"],
      "admin/*": ["admin/src/*"],
      "frontend/*": ["frontend/src/*"],
      "@craftjs/core": ["admin/node_modules/@craftjs/core"]
    },
    "typeRoots": ["./admin/node_modules/@types", "./frontend/node_modules/@types", "./node_modules/@types"]
  },
  "include": ["admin/src", "frontend/src", "shared"]
}
