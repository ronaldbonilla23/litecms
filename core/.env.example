# Puerto HTTP del servidor
PORT=3000
# Secreto para firmar los JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-un-secreto-largo
# URL pública del sitio (sitemap, canonical)
SITE_URL=http://localhost:3000
# Nombre e idioma del sitio (título, JSON-LD, <html lang>)
SITE_NAME=LiteCMS
SITE_LANG=es
# false en staging: robots.txt bloquea todo y las páginas llevan noindex
SITE_INDEXABLE=true
# Orígenes permitidos para CORS, separados por coma (admin/frontend en desarrollo)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Tamaño máximo de subida en MB
MAX_UPLOAD_MB=10
# Número de proxies delante del servidor (cPanel/Nginx: 1). Vacío = sin proxy
TRUST_PROXY=
