<main class="max-w-6xl mx-auto px-6 py-20">
  <p class="text-primary text-xs font-bold uppercase tracking-widest">Servicios</p>
  <h1 class="font-header text-4xl md:text-6xl font-black tracking-tight mt-3 mb-4">{{type.name}}</h1>
  <p class="text-lg opacity-70 max-w-2xl mb-14">{{type.description}}</p>
  <div class="grid gap-6 md:grid-cols-3">
    {{#each entries}}
      <a href="{{url}}" class="group block rounded-3xl border border-white/10 p-8 hover:border-primary transition-colors">
        <span class="text-4xl">{{fields.icono}}</span>
        <h2 class="font-header text-2xl font-bold mt-6 group-hover:text-primary">{{title}}</h2>
        <p class="opacity-70 mt-3">{{fields.resumen}}</p>
        {{#if fields.precio_desde}}<p class="text-sm mt-6 opacity-60">Desde USD {{fields.precio_desde}}</p>{{/if}}
      </a>
    {{/each}}
  </div>
</main>
