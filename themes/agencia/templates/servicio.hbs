<main class="max-w-3xl mx-auto px-6 py-20">
  <a href="{{type.url_prefix}}" class="text-sm opacity-60 hover:text-primary">← {{type.name}}</a>
  <span class="block text-5xl mt-10">{{entry.fields.icono}}</span>
  <h1 class="font-header text-4xl md:text-6xl font-black tracking-tight mt-6">{{entry.title}}</h1>
  <p class="text-xl opacity-80 mt-6">{{entry.fields.resumen}}</p>
  {{#if entry.fields.precio_desde}}
    <p class="inline-block mt-8 rounded-full border border-primary/40 text-primary px-4 py-1 text-sm">Desde USD {{entry.fields.precio_desde}}</p>
  {{/if}}
  <div class="prose prose-invert prose-lg max-w-none mt-12">{{{entry.fields.descripcion}}}</div>
  <a href="/contacto" class="inline-block mt-14 rounded-full bg-primary text-black font-bold px-8 py-4 hover:opacity-90">Pedir presupuesto</a>
</main>
