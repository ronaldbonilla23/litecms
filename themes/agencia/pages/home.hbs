<main>
  <section class="max-w-6xl mx-auto px-6 pt-24 pb-20">
    <p class="text-primary text-xs font-bold uppercase tracking-widest">Diseño · SEO · Contenido</p>
    <h1 class="font-header text-5xl md:text-7xl font-black tracking-tight leading-none mt-6 max-w-4xl">
      Sitios que se encuentran y <span class="text-primary">convierten</span>.
    </h1>
    <p class="text-xl opacity-70 mt-8 max-w-2xl">Diseñamos y posicionamos sitios rápidos para marcas que quieren crecer en buscadores y en asistentes de IA.</p>
    <div class="flex flex-wrap gap-4 mt-10">
      <a href="/contacto" class="rounded-full bg-primary text-black font-bold px-8 py-4 hover:opacity-90">Cuéntanos tu proyecto</a>
      <a href="/servicios" class="rounded-full border border-white/20 px-8 py-4 hover:border-primary">Ver servicios</a>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16">
    <h2 class="font-header text-3xl md:text-4xl font-black tracking-tight mb-10">Qué hacemos</h2>
    <div class="grid gap-6 md:grid-cols-3">
      {{#each (query "servicios" limit=3)}}
        <a href="{{url}}" class="group block rounded-3xl bg-white/5 p-8 hover:bg-white/10 transition-colors">
          <span class="text-4xl">{{fields.icono}}</span>
          <h3 class="font-header text-2xl font-bold mt-6 group-hover:text-primary">{{title}}</h3>
          <p class="opacity-70 mt-3">{{fields.resumen}}</p>
        </a>
      {{/each}}
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16">
    <h2 class="font-header text-3xl md:text-4xl font-black tracking-tight mb-10">Lo que dicen</h2>
    <div class="grid gap-6 md:grid-cols-2">
      {{#each (query "testimonios")}}
        <figure class="rounded-3xl border border-white/10 p-8">
          <blockquote class="text-xl leading-relaxed">“{{fields.cita}}”</blockquote>
          <figcaption class="mt-6 text-sm"><strong>{{title}}</strong> <span class="opacity-60">· {{fields.cargo}}</span></figcaption>
        </figure>
      {{/each}}
    </div>
  </section>
</main>
